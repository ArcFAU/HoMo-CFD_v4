# --- Secrets / credentials — never commit these ---
*.ppk
*.pem
*.key
**/podkey*
**/*sftp*credentials*
.env
.env.*

# --- Real CFD result data — big, and it's Octanes' data, not code ---
# Keep a small synthetic/sample tree in tests/fixtures/ instead if needed.
/finished/
/inProgress/
/unsimulated/
/archive/
/0830_mk3/
/CFD-Tool.zip
/homo-cfd_0930.zip
**/plots/
**/PressureDistributions/
*.csv
!tests/**/*.csv
*.png
!web/**/*.png
!docs/**/*.png

# --- OS / editor junk ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Python (in case serve.py grows a venv / FastAPI later) ---
__pycache__/
*.pyc
.venv/
venv/

# --- Node (in case this ever moves to a JS build step) ---
node_modules/
dist/
.cache/

# --- Logs ---
*.log
# --- SLURM job logs (mesh.o*, rans.o*, post.o*): they print the STAR-CCM+ licence key ---
*.o[0-9]*

# --- STAR-CCM+ simulation reports (large; may describe confidential designs) ---
/RANS.html
